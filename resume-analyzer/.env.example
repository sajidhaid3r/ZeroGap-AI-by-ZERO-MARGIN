# Copy to .env and adjust as needed. All values shown are the defaults
# used if a variable is unset (see app/config.py).

# --- File handling ---
MAX_FILE_SIZE_BYTES=5242880

# --- OCR ---
OCR_DPI=300

# --- Matching ---
FUZZY_MATCH_THRESHOLD=85

# --- Gap detection ---
GAP_THRESHOLD_MONTHS=3

# --- Resume length thresholds (word count) ---
MIN_WORD_COUNT=150
IDEAL_MAX_WORD_COUNT=700
STRETCH_MAX_WORD_COUNT=1100

# --- Age-bias thresholds ---
OLD_GRADUATION_THRESHOLD_YEARS=20
LONG_TENURE_THRESHOLD_YEARS=15

# --- LLM quality layer (leave unset to disable) ---
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Persistence ---
DATABASE_PATH=resume_analyzer.db

# --- CORS (comma-separated origins, or * for all) ---
CORS_ALLOWED_ORIGINS=*

# --- Logging ---
LOG_LEVEL=INFO
