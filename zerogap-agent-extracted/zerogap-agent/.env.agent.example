# ── Agent model (any OpenAI-compatible endpoint serving an open-weight model) ──
# Defaults: Groq + the same Qwen model the rest of ZeroGap already uses.
# AGENT_LLM_BASE_URL=https://api.groq.com/openai/v1
# AGENT_LLM_API_KEY=            # falls back to GROQ_API_KEY
# AGENT_LLM_MODEL=qwen/qwen3.8-27b
#
# Fully local / self-hosted examples:
# AGENT_LLM_BASE_URL=http://localhost:11434/v1   # Ollama
# AGENT_LLM_MODEL=qwen3:8b

# ── Optional tool data sources ──
ADZUNA_APP_ID=        # live job search; without it the agent uses clearly-labelled sample jobs
ADZUNA_APP_KEY=
GITHUB_TOKEN=         # optional; raises GitHub API rate limits for the evidence tool
